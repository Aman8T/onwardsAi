{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tayyari-api",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "server/index.ts"
      ],
      "port": 8787
    },
    {
      "name": "tayyari-api-py",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "python",
        "-m",
        "tayyari.cli",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "tayyari-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite"
      ],
      "port": 5173
    }
  ]
}
