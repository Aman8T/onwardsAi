# Tayyari backend configuration. Copy to `.env` (repo root or backend/), fill in the secrets, never commit it.
# Real environment variables always win over these files; backend/.env wins over the repo-root .env.
# Empty values count as unset. Every variable is optional except ANTHROPIC_API_KEY for real analysis and chat.

# ───────────── credentials and endpoints (no TAYYARI_ prefix) ─────────────

# Anthropic API key: readers (Haiku), synthesis and chat (Sonnet). Required for analysis and chat.
ANTHROPIC_API_KEY=
# Jev (TypeSafe) API key for the decision layer. Alias: TYPESAFE_API_KEY. Without it Jev decisions are skipped.
JEV_API_KEY=
# Optional GitHub token (no scopes needed): raises the GitHub API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=
# Postgres connection string (Neon; FastAPI Cloud injects it). Unset: SQLite under the data folder.
DATABASE_URL=
# Optional Logfire write token; used only when the `logfire` package is installed.
LOGFIRE_TOKEN=

# ───────────── accounts (no TAYYARI_ prefix) ─────────────

# Google sign-in (OAuth 2.0 web client). Create it at console.cloud.google.com > APIs & Services > Credentials and
# add this redirect URI: <public URL>/api/auth/google/callback (http://localhost:5173/api/auth/google/callback
# while developing; https://tayyari.fastapicloud.dev/api/auth/google/callback in production). Both values are
# needed; without them the "Continue with Google" button is hidden. On the cloud:
#   fastapi cloud env set --secret GOOGLE_CLIENT_ID    (and the same for GOOGLE_CLIENT_SECRET)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend API key for the emailed sign-in link (https://resend.com). Without it a LOCAL server logs the link and
# returns it in the response so the flow can be tested; any other server hides email sign-in.
RESEND_API_KEY=
# Sender of the sign-in email on a domain verified in Resend, e.g. "Tayyari <login@example.com>". Not a secret.
# Unset: Resend's shared test sender (onboarding@resend.dev), which only delivers to your own Resend account.
RESEND_FROM=

# ───────────── payments (no TAYYARI_ prefix) ─────────────

# Indian rupees go through Razorpay (https://dashboard.razorpay.com). The key id and key secret are what INR plans
# need: Account & Settings > API keys (use the test-mode pair first). With both set, INR plans are offered.
# The webhook secret is optional and recommended on the cloud. Choose it yourself when you add the webhook at
# Account & Settings > Webhooks: URL <public URL>/api/billing/webhooks/razorpay, events order.paid,
# payment.captured and payment.failed. The browser hand-off settles an order at once; the webhook covers a payment
# whose browser never came back. Without the webhook secret that route answers 503, and the server logs
# razorpay_webhooks_off once at start.
# On the cloud: fastapi cloud env set --secret RAZORPAY_KEY_SECRET   (and the same for the other four names below)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# US dollars go through Stripe (https://dashboard.stripe.com). Secret key: Developers > API keys (start with an
# sk_test_ key). The webhook signing secret (whsec_...) comes from Developers > Webhooks > Add endpoint: URL
# <public URL>/api/billing/webhooks/stripe, events checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed and checkout.session.expired.
# Both are needed; with either missing, USD plans are not offered.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ───────────── runtime ─────────────

# local | prod | test. Detected automatically (prod on FastAPI Cloud); set it only to override.
# TAYYARI_ENV=local
# Log verbosity: DEBUG | INFO | WARNING | ERROR.
# TAYYARI_LOG_LEVEL=INFO
# Port of the dev server (the Vite proxy targets 8787).
# TAYYARI_API_PORT=8787
# Folder for local files (the SQLite database). Default: your user data folder, or the temp folder in prod.
# TAYYARI_DATA_DIR=
# Multiplier for the delays that space out UI events; 0 removes them (tests, fast demos).
# TAYYARI_PACING_SCALE=1.0

# ───────────── models ─────────────

# Haiku reader, one per source.
# TAYYARI_READER_MODEL=claude-haiku-4-5
# Sonnet synthesis of the skill graph (and the portfolio copy).
# TAYYARI_SYNTH_MODEL=claude-sonnet-5-5
# Sonnet career chat.
# TAYYARI_CHAT_MODEL=claude-sonnet-5-5
# POC cost mode (local .env and FastAPI Cloud since 2026-10-08): all three set to claude-haiku-5-5
# (~$0.02 per analysis, ~$0.01 per portfolio). Unset them to return to the defaults above.
# Extended thinking for the readers (1/true/on). Off: they extract rather than reason.
# TAYYARI_READER_THINKING=false
# Effort for synthesis and chat: low | medium | high | xhigh | max.
# TAYYARI_SYNTH_EFFORT=medium
# TAYYARI_CHAT_EFFORT=medium
# Output token caps (synthesis includes Sonnet's thinking tokens).
# TAYYARI_READER_MAX_TOKENS=8000
# TAYYARI_SYNTH_MAX_TOKENS=32000
# TAYYARI_CHAT_MAX_TOKENS=8000
# Prompt caching: synthesis off | system | system+data; chat cache lifetime 5m | 1h.
# TAYYARI_SYNTH_CACHE=system
# TAYYARI_CHAT_CACHE_TTL=5m
# Feed the Jev first-read results to the synthesizer as hints (off: stored for comparison only).
# TAYYARI_SYNTH_HINTS=false

# ───────────── Jev decisions (nested: TAYYARI_JEV__*) ─────────────

# Kill switch: false skips every Jev call (decisions fall back or stay neutral).
# TAYYARI_JEV__ENABLED=true
# Pinned Jev model; logged with every decision so replays never mix versions.
# TAYYARI_JEV__MODEL=jev-1.13.0
# TAYYARI_JEV__BASE_URL=https://api.typesafe.ai
# Seconds allowed for live display decisions and for post-synthesis evidence checks.
# TAYYARI_JEV__TIMEOUT_DISPLAY_S=2.5
# TAYYARI_JEV__TIMEOUT_EVIDENCE_S=4.0
# TAYYARI_JEV__MAX_RETRIES=1
# true sends contact details to Jev too. Default false: emails, phones and address lines are masked first.
# TAYYARI_JEV__SEND_PII=false
# Emergency per-decision overrides of decisions/defaults.toml, as JSON.
# TAYYARI_DECISION_OVERRIDES={"evidence.support":{"mode":"shadow"}}

# ───────────── cost guard (nested: TAYYARI_GUARD__*) ─────────────

# Master switch for rate limits and the spend ceiling.
# TAYYARI_GUARD__ENABLED=true
# Per-IP limits on /api/analyze, then on /api/chat; plus a global cap on analyses per hour.
# TAYYARI_GUARD__ANALYZE_PER_MINUTE=2
# TAYYARI_GUARD__ANALYZE_PER_HOUR=6
# TAYYARI_GUARD__ANALYZE_PER_DAY=15
# TAYYARI_GUARD__ANALYZE_GLOBAL_PER_HOUR=60
# TAYYARI_GUARD__CHAT_PER_MINUTE=20
# TAYYARI_GUARD__CHAT_PER_HOUR=120
# TAYYARI_GUARD__CHAT_PER_DAY=400
# Soft ceiling on AI spend per UTC day in USD; reaching it switches AI off until midnight UTC.
# TAYYARI_GUARD__DAILY_CEILING_USD=20.0
# Estimated cost admitted per analysis and per chat turn, and the overshoot factor an analysis already past
# the readers may use.
# TAYYARI_GUARD__EST_ANALYZE_USD=0.40
# TAYYARI_GUARD__EST_CHAT_USD=0.10
# Posting matches (POST /api/match): per account and, separately, per client address (0 = window not enforced), a cap
# across all accounts per hour, and the spend reserved before one (also held while a resume or cover note is written).
# Re-checks after answers, resumes, cover notes and downloads are not matches and are never counted here.
# TAYYARI_GUARD__MATCH_PER_MINUTE=0
# TAYYARI_GUARD__MATCH_PER_HOUR=10
# TAYYARI_GUARD__MATCH_PER_DAY=30
# TAYYARI_GUARD__MATCH_GLOBAL_PER_HOUR=120
# TAYYARI_GUARD__EST_MATCH_USD=0.06
# Posting matches without an account (see TAYYARI_MATCH__ALLOW_ANONYMOUS): how many one client address may start per
# day (0 = not enforced). Counted for POST /api/match only, and on top of the per-address windows above; with no
# account there is nothing to charge, so this is the only meter on such a run.
# TAYYARI_GUARD__ANON_MATCH_PER_DAY=3
# TAYYARI_GUARD__CEILING_GRACE=1.25
# Proxies in front of the app (the client IP is that many entries from the right of X-Forwarded-For)...
# TAYYARI_GUARD__TRUSTED_PROXY_HOPS=1
# ...or a header that already carries the real client IP.
# TAYYARI_GUARD__CLIENT_IP_HEADER=

# ───────────── concurrency (nested: TAYYARI_CONCURRENCY__*) ─────────────

# Haiku readers running at once per analysis, and the timeout of each.
# TAYYARI_CONCURRENCY__READER_CONCURRENCY=6
# TAYYARI_CONCURRENCY__READER_TIMEOUT_S=90
# Analyses running at once per replica.
# TAYYARI_CONCURRENCY__MAX_CONCURRENT_ANALYSES=4

# ───────────── retention (nested: TAYYARI_RETENTION__*) ─────────────

# Anonymous profiles not opened for this many days are deleted, and so are "Try a sample profile" runs (the bundled sample
# persona is kept). Profiles saved to an account are kept until the account is deleted.
# TAYYARI_RETENTION__PROFILE_DAYS=60
# Jev request/response payloads and states are purged after this many days.
# TAYYARI_RETENTION__PAYLOAD_DAYS=30
# Decision and call metadata (no text) is kept this many days.
# TAYYARI_RETENTION__METADATA_DAYS=180

# ───────────── accounts (nested: TAYYARI_AUTH__*) ─────────────

# How long a sign-in lasts (sliding: each use, at most hourly, pushes it out again) and how long an emailed link works.
# TAYYARI_AUTH__SESSION_DAYS=30
# TAYYARI_AUTH__MAGIC_LINK_MINUTES=15
# Sign-in links one email address, and one client, may ask for per 15 minutes (0 = not enforced).
# TAYYARI_AUTH__MAGIC_PER_EMAIL=3
# TAYYARI_AUTH__MAGIC_PER_IP=3
# Name of the session cookie.
# TAYYARI_AUTH__COOKIE_NAME=tayyari_session
# Where the app is reached from outside: the base of the emailed link and of Google's callback URL. Default:
# FASTAPI_PUBLIC_URL (set by FastAPI Cloud), else http://localhost:5173 (the Vite dev server, which proxies /api).
# TAYYARI_AUTH__PUBLIC_URL=


# ───────────── payments (nested: TAYYARI_BILLING__*) ─────────────

# Prices in the currency's minor unit (paise, cents). 0 or unset = not on sale: the pricing page says "Coming soon"
# and checkout answers 409. A plan also needs its provider's secrets above (INR: Razorpay, USD: Stripe).
# Floors: at least 100 paise (Razorpay) and 50 cents (Stripe). A lower price counts as not on sale and is logged at start.
# pack3: three posting matches, no expiry. pass30: unlimited postings for 30 days from purchase (no auto-renew).
# TAYYARI_BILLING__PACK3_INR=
# TAYYARI_BILLING__PASS30_INR=
# TAYYARI_BILLING__PACK3_USD=
# TAYYARI_BILLING__PASS30_USD=
# Posting matches every account gets free each calendar month (UTC). 0 turns the free allowance off.
# TAYYARI_BILLING__FREE_MATCHES_PER_MONTH=1

# ───────────── posting match (nested: TAYYARI_MATCH__*) ─────────────

# The model that reads the posting and classifies (posting, facts, gates, coverage, relevance). Unset: the reader model.
# TAYYARI_MATCH__MODEL=
# The model that phrases resume sentences and writes the cover note. Unset: the same as MODEL.
# TAYYARI_MATCH__WRITER_MODEL=
# The longest posting text accepted, pasted or fetched (the reader never takes more than 20000).
# TAYYARI_MATCH__MAX_POSTING_CHARS=20000
# Seconds one classification call may take before its stage settles for the honest default (unknown / uncertain).
# TAYYARI_MATCH__CALL_TIMEOUT_S=90
# Whether a visitor with no sign-in may match a posting: auto | true | false. auto (the default) allows it exactly when this
# server offers no way to sign in (neither Google nor an emailed link), because then an account is not something a
# person can get. true always allows it (a signed-in person is still charged as usual). false never does: every
# /api/match route answers 401 without a sign-in. GET /api/me reports the result as `anonymousMatch`.
# TAYYARI_MATCH__ALLOW_ANONYMOUS=auto

# ───────────── discover (nested: TAYYARI_DISCOVER__*) ─────────────

# Job discovery reads only employers' own public job boards (Greenhouse and Lever). No key is needed. false turns the
# routes off (503 discover_disabled) and fetches nothing.
# TAYYARI_DISCOVER__ENABLED=true
# How old the last good refresh may get (hours) before the next request starts one in the background. The same refresh runs
# as its own process: `python -m tayyari.cli discover-refresh` once, `discover-worker` in a loop.
# TAYYARI_DISCOVER__REFRESH_HOURS=6
# Employer boards fetched at once, and the longest one request may take (seconds).
# TAYYARI_DISCOVER__FETCH_CONCURRENCY=4
# TAYYARI_DISCOVER__REQUEST_TIMEOUT_S=15
# Listings kept per employer in India (a bigger board is cut here).
# TAYYARI_DISCOVER__MAX_LISTINGS_PER_EMPLOYER=300
# The employer registry (JSON). Unset: the one shipped with the package (tayyari/discover/data/employers.json).
# TAYYARI_DISCOVER__REGISTRY_PATH=
