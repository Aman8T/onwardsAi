# Tayyari backend configuration. Copy to `.env` (repo root or backend/), fill in the secrets, never commit it.
# Real environment variables always win over these files; backend/.env wins over the repo-root .env.
# Empty values count as unset. Every variable is optional except ANTHROPIC_API_KEY for real analysis and chat.

# ───────────── credentials and endpoints (no TAYYARI_ prefix) ─────────────

# Anthropic API key: readers (Haiku), synthesis and chat (Sonnet). Required for analysis and chat.
ANTHROPIC_API_KEY=
# Jev (TypeSafe) API key for the decision layer. Alias: TYPESAFE_API_KEY. Without it Jev decisions are skipped.
JEV_API_KEY=
# Optional GitHub token (no scopes needed): raises the GitHub API limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=
# Postgres connection string (Neon; FastAPI Cloud injects it). Unset: SQLite under the data folder.
DATABASE_URL=
# Optional Logfire write token; used only when the `logfire` package is installed.
LOGFIRE_TOKEN=

# ───────────── runtime ─────────────

# local | prod | test. Detected automatically (prod on FastAPI Cloud); set it only to override.
# TAYYARI_ENV=local
# Log verbosity: DEBUG | INFO | WARNING | ERROR.
# TAYYARI_LOG_LEVEL=INFO
# Port of the dev server (the Vite proxy targets 8787).
# TAYYARI_API_PORT=8787
# Folder for local files (the SQLite database). Default: your user data folder, or the temp folder in prod.
# TAYYARI_DATA_DIR=
# Multiplier for the delays that space out UI events; 0 removes them (tests, fast demos).
# TAYYARI_PACING_SCALE=1.0

# ───────────── models ─────────────

# Haiku reader, one per source.
# TAYYARI_READER_MODEL=claude-haiku-4-5
# Sonnet synthesis of the skill graph.
# TAYYARI_SYNTH_MODEL=claude-sonnet-5-5
# Sonnet career chat.
# TAYYARI_CHAT_MODEL=claude-sonnet-5-5
# Extended thinking for the readers (1/true/on). Off: they extract rather than reason.
# TAYYARI_READER_THINKING=false
# Effort for synthesis and chat: low | medium | high | xhigh | max.
# TAYYARI_SYNTH_EFFORT=medium
# TAYYARI_CHAT_EFFORT=medium
# Output token caps (synthesis includes Sonnet's thinking tokens).
# TAYYARI_READER_MAX_TOKENS=8000
# TAYYARI_SYNTH_MAX_TOKENS=32000
# TAYYARI_CHAT_MAX_TOKENS=8000
# Prompt caching: synthesis off | system | system+data; chat cache lifetime 5m | 1h.
# TAYYARI_SYNTH_CACHE=system
# TAYYARI_CHAT_CACHE_TTL=5m
# Feed the Jev first-read results to the synthesizer as hints (off: stored for comparison only).
# TAYYARI_SYNTH_HINTS=false

# ───────────── Jev decisions (nested: TAYYARI_JEV__*) ─────────────

# Kill switch: false skips every Jev call (decisions fall back or stay neutral).
# TAYYARI_JEV__ENABLED=true
# Pinned Jev model; logged with every decision so replays never mix versions.
# TAYYARI_JEV__MODEL=jev-1.13.0
# TAYYARI_JEV__BASE_URL=https://api.typesafe.ai
# Seconds allowed for live display decisions and for post-synthesis evidence checks.
# TAYYARI_JEV__TIMEOUT_DISPLAY_S=2.5
# TAYYARI_JEV__TIMEOUT_EVIDENCE_S=4.0
# TAYYARI_JEV__MAX_RETRIES=1
# true sends contact details to Jev too. Default false: emails, phones and address lines are masked first.
# TAYYARI_JEV__SEND_PII=false
# Emergency per-decision overrides of decisions/defaults.toml, as JSON.
# TAYYARI_DECISION_OVERRIDES={"evidence.support":{"mode":"shadow"}}

# ───────────── cost guard (nested: TAYYARI_GUARD__*) ─────────────

# Master switch for rate limits and the spend ceiling.
# TAYYARI_GUARD__ENABLED=true
# Per-IP limits on /api/analyze, then on /api/chat; plus a global cap on analyses per hour.
# TAYYARI_GUARD__ANALYZE_PER_MINUTE=2
# TAYYARI_GUARD__ANALYZE_PER_HOUR=6
# TAYYARI_GUARD__ANALYZE_PER_DAY=15
# TAYYARI_GUARD__ANALYZE_GLOBAL_PER_HOUR=60
# TAYYARI_GUARD__CHAT_PER_MINUTE=20
# TAYYARI_GUARD__CHAT_PER_HOUR=120
# TAYYARI_GUARD__CHAT_PER_DAY=400
# Soft ceiling on AI spend per UTC day in USD; reaching it switches AI off until midnight UTC.
# TAYYARI_GUARD__DAILY_CEILING_USD=20.0
# Estimated cost admitted per analysis and per chat turn, and the overshoot factor an analysis already past
# the readers may use.
# TAYYARI_GUARD__EST_ANALYZE_USD=0.40
# TAYYARI_GUARD__EST_CHAT_USD=0.10
# TAYYARI_GUARD__CEILING_GRACE=1.25
# Proxies in front of the app (the client IP is that many entries from the right of X-Forwarded-For)...
# TAYYARI_GUARD__TRUSTED_PROXY_HOPS=1
# ...or a header that already carries the real client IP.
# TAYYARI_GUARD__CLIENT_IP_HEADER=

# ───────────── concurrency (nested: TAYYARI_CONCURRENCY__*) ─────────────

# Haiku readers running at once per analysis, and the timeout of each.
# TAYYARI_CONCURRENCY__READER_CONCURRENCY=6
# TAYYARI_CONCURRENCY__READER_TIMEOUT_S=90
# Analyses running at once per replica.
# TAYYARI_CONCURRENCY__MAX_CONCURRENT_ANALYSES=4

# ───────────── retention (nested: TAYYARI_RETENTION__*) ─────────────

# Profiles not opened for this many days are deleted (sample rows are kept).
# TAYYARI_RETENTION__PROFILE_DAYS=60
# Jev request/response payloads and states are purged after this many days.
# TAYYARI_RETENTION__PAYLOAD_DAYS=30
# Decision and call metadata (no text) is kept this many days.
# TAYYARI_RETENTION__METADATA_DAYS=180
