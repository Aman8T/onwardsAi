{
  "name": "tayyari",
  "private": true,
  "version": "0.1.0",
  "description": "Tayyari — hyper-personalized career intelligence (POC). Resume + GitHub + Lovable + links → interactive skill graph → Claude-powered career chat.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "tsx server/index.ts",
    "demo": "vite build && tsx server/index.ts",
    "smoke": "tsx server/scripts/smoke.ts",
    "make-sample": "tsx server/scripts/make-sample.ts",
    "ingest-check": "tsx server/scripts/ingest-check.ts",
    "check:palette": "tsx scripts/palette-check.ts",
    "emit:fallback": "tsx scripts/palette-check.ts --fallback 250",
    "check:restraint": "tsx scripts/restraint-check.ts",
    "check:build": "vite build && tsx scripts/build-check.ts",
    "check": "npm run typecheck && npm run check:palette && npm run check:restraint && npm run check:build",
    "cloud:build": "vite build && node backend/build-static.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.290",
    "express": "^5.2.1",
    "mammoth": "^1.13.0",
    "motion": "^14.0.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
